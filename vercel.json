{
  "crons": [
    {
      "path": "/api/validator-alerts/check",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/verify/cleanup",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/explorer/query/warm",
      "schedule": "30 5 * * *"
    }
  ],
  "functions": {
    "app/api/verify/**/route.ts": {
      "memory": 4096,
      "maxDuration": 300
    }
  }
}
