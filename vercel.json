{
  "buildCommand": "yarn build:remote && node ./scripts/build-with-typecheck.mjs && yarn update-index",
  "crons": [
    {
      "path": "/api/validator-alerts/check",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/verify/cleanup",
      "schedule": "0 4 * * *"
    }
  ],
  "functions": {
    "app/api/verify/**/route.ts": {
      "memory": 4096,
      "maxDuration": 300
    }
  }
}
