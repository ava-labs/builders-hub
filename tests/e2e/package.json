{
  "name": "builders-hub-e2e",
  "private": true,
  "type": "module",
  "description": "Browser tests for build.avax.network, run with tester-army/e2e",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "E2E_TELEMETRY_DISABLED=1 e2e run",
    "test:desktop": "E2E_TELEMETRY_DISABLED=1 e2e run --target desktop",
    "test:phone": "E2E_TELEMETRY_DISABLED=1 e2e run --target phone",
    "test:api": "E2E_TELEMETRY_DISABLED=1 e2e run --config api/e2e.config.ts",
    "list": "E2E_TELEMETRY_DISABLED=1 e2e list",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "4.0.65",
    "@e2e-dev/web": "0.11.1",
    "@types/node": "^24.5.0",
    "ai": "7.0.116",
    "e2e": "0.15.1",
    "playwright": "1.63.0",
    "typescript": "5.9.2",
    "zod": "4.6.1"
  }
}
